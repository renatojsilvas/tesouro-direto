// Tarefa 77 — coletor único que substitui prometheus/loki/promtail/node-exporter/grafana.
// Os nomes de `job` abaixo são CONTRATO com as 18 regras de alerta: mudar um deixa
// alertas mudos em silêncio. Ver docs/superpowers/plans/2026-08-14-tarefa-77-*.md.

prometheus.remote_write "cloud" {
	endpoint {
		url = sys.env("GC_PROM_URL")

		basic_auth {
			username = sys.env("GC_PROM_USER")
			password = sys.env("GC_TOKEN")
		}
	}
}

// job="tesouro-direto-api" — consumido por 12 das 18 regras.
prometheus.scrape "app" {
	targets         = [{__address__ = "app:8080", job = "tesouro-direto-api"}]
	metrics_path    = "/metrics"
	scrape_interval = "30s" // NÃO subir para 60s: quebra o `for: 1m` de td-db-readiness-down
	forward_to      = [prometheus.remote_write.cloud.receiver]
}

// job="hub-precos" — Hub de Preços (repo hub-precos), que compartilha esta VPS e a
// rede `tesouro-net`. O alvo é o container_name de docker-compose.prod.yml daquele
// repo. Job NOVO: não toca no contrato das 18 regras de alerta acima.
prometheus.scrape "hub" {
      targets         = [{__address__ = "hub-precos-app:8080", job = "hub-precos"}]
      metrics_path    = "/metrics"
      scrape_interval = "30s"
      forward_to      = [prometheus.remote_write.cloud.receiver]
}

// job="operacoes" — serviço Operações (repo operacoes), que compartilha esta VPS e a
// rede `tesouro-net`. O alvo é o alias `operacoes-app` registrado tanto pelo nome do
// serviço quanto pelo container_name em docker-compose.prod.yml daquele repo (PADROES
// §10.1 conferido: nem "operacoes" nem "operacoes-app" colidem com os aliases já
// ocupados na rede). Job NOVO: não toca no contrato das 18 regras de alerta acima nem
// nas 4 do Hub — `verificar-f1.sh` do repo operacoes procura `job="operacoes"` e as
// regras de infra/grafana/cloud/rules-operacoes.yaml filtram por ele.
prometheus.scrape "operacoes" {
      targets         = [{__address__ = "operacoes-app:8080", job = "operacoes"}]
      metrics_path    = "/metrics"
      scrape_interval = "30s"
      forward_to      = [prometheus.remote_write.cloud.receiver]
}

// Substituiu o container `node-exporter` (77.1; o serviço foi removido do
// docker-compose.yml na 77.4). Os NOMES de coletor são os mesmos que ele usava —
// inclusive o textfile, que sustenta 7 regras de alerta.
// Os SUB-FILTROS default do node-exporter embutido no Alloy v1.18.1 divergem dos do
// prom/node-exporter:v1.12.1 que rodava até a 77.4 (lib vendored de versão diferente):
// o default do Alloy para diskstats.device-exclude NÃO exclui zram, e o de
// filesystem.fs-types-exclude NÃO exclui erofs. Por isso os dois blocos abaixo declaram
// os valores EFETIVOS lidos do próprio node-exporter quando ele ainda rodava em
// produção (`docker logs tesouro-direto-node-exporter`, linhas "Parsed flag
// --collector.diskstats.device-exclude"/"...filesystem.fs-types-exclude" — os defaults
// compilados dele, já que o compose não os sobrescrevia), em vez de confiar no default
// de biblioteca do Alloy. Inofensivo nesta VPS hoje (só vda/vdb, sem zram), mas evita
// divergência silenciosa em outra máquina.
prometheus.exporter.unix "host" {
	procfs_path = "/host/proc"
	sysfs_path  = "/host/sys"
	rootfs_path = "/rootfs"

	set_collectors = [
		"cpu", "meminfo", "loadavg", "filesystem", "diskstats",
		"netdev", "stat", "uname", "time", "os", "textfile",
	]

	filesystem {
		mount_points_exclude = "^/(sys|proc|dev|host|etc)($|/)"
		fs_types_exclude     = "^(autofs|binfmt_misc|bpf|cgroup2?|configfs|debugfs|devpts|devtmpfs|fusectl|hugetlbfs|iso9660|mqueue|nsfs|overlay|proc|procfs|pstore|rpc_pipefs|securityfs|selinuxfs|squashfs|erofs|sysfs|tracefs)$"
	}

	// O bloco de configuração do coletor "diskstats" chama-se "disk" no schema do Alloy.
	disk {
		device_exclude = "^(z?ram|loop|fd|(h|s|v|xv)d[a-z]|nvme\\d+n\\d+p)\\d+$"
	}

	// Sem isso, cada deploy cria veth* novas = lote novo de séries ativas contra o teto de 10k.
	netdev {
		device_exclude = "^(veth.*|docker.*|br-.*)$"
	}

	textfile {
		directory = "/host/textfile"
	}
}

// job="node" — consumido por td-disco-cheio e pelas 7 regras td-container-*.
// O exporter.unix rotula os alvos com um job próprio; discovery.relabel força o nome do contrato.
discovery.relabel "node" {
	targets = prometheus.exporter.unix.host.targets

	rule {
		target_label = "job"
		replacement  = "node"
	}
}

prometheus.scrape "node" {
	targets         = discovery.relabel.node.output
	scrape_interval = "30s"
	forward_to      = [prometheus.remote_write.cloud.receiver]
}

// 80.1 — auto-observação do Alloy: até aqui ele coletava para os outros dois
// jobs mas não expunha as próprias métricas de processo (goroutines, uso de
// memória do runtime, filas de remote_write etc.) para a nuvem.
// job="alloy" é contrato como "tesouro-direto-api" e "node" acima: se a 80.2
// vier a escrever uma regra de alerta filtrando por ele, é este nome que ela
// vai casar. A técnica do discovery.relabel para FORÇAR o `job` (em vez de
// declará-lo direto no target) é a mesma que a 77.1 usou para "node" (linhas
// 67-82) e pelo mesmo motivo: o endpoint próprio do Alloy não nasce com um
// job customizável no target, então o relabel é quem define o label real da
// série — âncora sintática que o teste de contrato usa.
// 127.0.0.1:12345, não "alloy:12345" nem "localhost": o scrape roda DENTRO do
// processo Alloy, que sobe com `--server.http.listen-addr=0.0.0.0:12345`
// (docker-compose.yml) — o próprio processo é o alvo.
// Cardinalidade medida em 2026-08-16 17:36 UTC (antes desta mudança, via
// `count({__name__=~".+"})` na API de query do Grafana Cloud): a nuvem tinha
// 675 séries ativas; o endpoint /metrics do Alloy expõe 551 séries.
discovery.relabel "alloy" {
	targets = [{__address__ = "127.0.0.1:12345"}]

	rule {
		target_label = "job"
		replacement  = "alloy"
	}
}

prometheus.scrape "alloy" {
	targets         = discovery.relabel.alloy.output
	metrics_path    = "/metrics"
	scrape_interval = "30s"
	forward_to      = [prometheus.remote_write.cloud.receiver]
}

// 77.2 — substitui loki + promtail. Quatro fluxos: nginx e kernel por tail
// (como o promtail fazia), API e Web via push HTTP (o loki.source.api abaixo),
// porque o sink Serilog.Sinks.Grafana.Loki não tem parâmetro de credencial
// (SerilogExtensions.cs:11). Em vez de dar o token do Grafana Cloud a dois
// processos .NET, o Alloy recebe o push em claro só na rede interna e reenvia
// autenticado — a credencial fica num lugar só.
loki.write "cloud" {
	endpoint {
		url = sys.env("GC_LOKI_URL")

		basic_auth {
			username = sys.env("GC_LOKI_USER")
			password = sys.env("GC_TOKEN")
		}
	}
}

// ---------- nginx ----------
local.file_match "nginx" {
	path_targets = [{__path__ = "/var/log/nginx/*access.log", job = "nginx"}]
}

loki.source.file "nginx" {
	targets    = local.file_match.nginx.targets
	forward_to = [loki.process.nginx.receiver]
}

loki.process "nginx" {
	// Formato combined log; mesma decisão que o `promtail` usava
	// (infra/promtail/promtail-config.yml, removido na 77.4) — grupos nomeados
	// equivalentes; a sintaxe de regex do Alloy é RE2, a do Promtail também, só a forma
	// de cada classe de caractere varia.
	//
	// Revisão adversarial da 77.2 (achados 3 e 4) — divergências de classe de caractere
	// vs. o que o promtail usava (arquivo removido na 77.4), avaliadas uma a uma:
	//   - remote_addr ganhou `:` (`[\w\.:]+`, era `[\w\.]+`) DE PROPÓSITO: o combined log
	//     format sempre começa pelo remote_addr, seja qual for a família; sem `:` uma
	//     linha IPv6 falha a extração INTEIRA e perde status/method em silêncio.
	//   - method volta a `[A-Z]+` (era `[^ ]*`) — ver stage.labels abaixo.
	//   - status volta a `\d{3}` (era `[\d]+`) — status TAMBÉM é label (stage.labels);
	//     `[\d]+` sem teto de tamanho abre a mesma classe de risco de cardinalidade do
	//     achado do `method`, caso os campos se desalinhem numa linha malformada.
	//   - remote_user (`[^ ]*` vs `\S+`), request_uri (`[^ ]*` vs `\S+`) e protocol
	//     (`[^"]*` vs `[^"]+`) MANTIDOS como no diff da 77.2: nenhum dos três é
	//     promovido a label pelo stage.labels abaixo, então a diferença (0+ vs 1+,
	//     ou excluir só espaço vs. todo whitespace) não tem efeito de cardinalidade;
	//     sendo mais permissivos, na pior hipótese eles ajudam a linha a casar em vez
	//     de derrubar o parse inteiro por um campo que nem vira label.
	//   - time_local (`.*` vs `[^\]]+`) MANTIDO: em teoria `.*` guloso poderia
	//     estender a captura até um `] "` mais adiante na linha, mas o nginx escapa
	//     `"` nos campos referer/user_agent, então não há como injetar o literal `] "`
	//     que o faria backtrackar para o lugar errado; e mesmo que falhasse, o
	//     stage.timestamp cai para o horário de ingestão em vez de quebrar a linha —
	//     não é label, não abre cardinalidade.
	stage.regex {
		expression = `^(?P<remote_addr>[\w\.:]+) - (?P<remote_user>[^ ]*) \[(?P<time_local>.*)\] "(?P<method>[A-Z]+) (?P<request_uri>[^ ]*) (?P<protocol>[^"]*)" (?P<status>\d{3}) (?P<body_bytes_sent>[\d]+) "(?P<referer>[^"]*)" "(?P<user_agent>[^"]*)"`
	}

	// LGPD: o IP é dado pessoal e a transferência para o Grafana Labs é internacional
	// (Res. CD/ANPD 19/2024). Hash com salt ANTES do envio — nunca em claro sai da VPS.
	// O `topk by ip` do dashboard continua funcionando: ele só precisa DISTINGUIR
	// clientes, não saber o IP real. O salt é interpolado no NÍVEL DO RIVER via
	// sys.env(), concatenado à string do template — não dentro do template Go, porque
	// não há garantia de que `env` exista no escopo do template do stage.replace, e
	// descobrir isso só em produção (com o hash falhando calado) seria pior.
	//
	// Achado da revisão adversarial: `^(\d+\.\d+\.\d+\.\d+)` só casa IPv4. Uma linha que
	// comece com IPv6 (ou `::ffff:a.b.c.d`) não sofre a substituição e o IP vai em claro
	// para o Grafana Labs, sem erro visível. Ancorar no primeiro TOKEN da linha (sempre o
	// remote_addr no combined log format, qualquer que seja a família) é seguro mesmo no
	// pior caso: se a linha não for do formato esperado, o pior resultado é hashear um
	// token que não era IP — inofensivo, e falha para o lado seguro (nunca vaza em claro).
	stage.replace {
		expression = `^(\S+)`
		replace    = "{{ .Value | Hash \"" + sys.env("GC_IP_SALT") + "\" }}"
	}

	// Só status e method viram label — igual ao que o promtail fazia (arquivo removido
	// na 77.4).
	// Promover o IP a label seria cardinalidade aberta pelo usuário.
	//
	// Achado da revisão adversarial: o diff original trocou `[A-Z]+` (promtail) por
	// `[^ ]*` para method. Não é cosmético — com `[A-Z]+`, um token que não seja só
	// maiúsculas derruba a regex INTEIRA e a linha some sem labels (barreira de
	// cardinalidade de fato). Com `[^ ]*`, qualquer lixo de scanner vira valor do label
	// `method`, e o nginx só escapa `"`, `\`, controle e bytes altos — nada impedia um
	// método arbitrário de virar label. Restaurado para `[A-Z]+`.
	stage.labels {
		values = {status = "status", method = "method"}
	}

	stage.timestamp {
		source = "time_local"
		format = "02/Jan/2006:15:04:05 -0700"
	}

	forward_to = [loki.write.cloud.receiver]
}

// ---------- kernel (OOM) ----------
local.file_match "kernel" {
	path_targets = [{__path__ = "/var/log/host/kern.log", job = "kernel"}]
}

loki.source.file "kernel" {
	targets    = local.file_match.kernel.targets
	forward_to = [loki.process.kernel.receiver]
}

loki.process "kernel" {
	// Descarta tudo que não é OOM ANTES do envio — 50 GB/mês é o teto do free tier
	// (mesmo raciocínio que o promtail usava — arquivo removido na 77.4 —, duas formas
	// de OOM: dentro de um cgroup de container e OOM global do host).
	stage.match {
		selector            = `{job="kernel"} !~ "Memory cgroup out of memory|Out of memory: Killed process"`
		action              = "drop"
		drop_counter_reason = "not_oom"
	}

	// SEM stage.timestamp de propósito: o kern.log traz timestamp de syslog sem ano
	// (ex.: "Aug 12 03:14:07"). Parseado, o ano viraria 0000 e o Loki rejeitaria a
	// linha por estar fora da janela de aceitação ("too far behind") — a linha de OOM
	// sumiria calada, o oposto do objetivo desta tarefa. Usa-se o horário de ingestão
	// (mesma decisão que o promtail usava — arquivo removido na 77.4).
	forward_to = [loki.write.cloud.receiver]
}

// ---------- API e Web (push do Serilog) ----------
// job="tesouro-direto-api" e job="tesouro-direto-web" nascem do PRÓPRIO sink Serilog
// (SerilogExtensions.cs:22 em cada projeto), não daqui — loki.source.api só recebe o
// stream já rotulado e reenvia autenticado para a nuvem.
loki.source.api "app" {
	http {
		listen_address = "0.0.0.0"
		listen_port    = 3100
	}

	forward_to = [loki.write.cloud.receiver]
}
