{
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*",
  "ConnectionStrings": { "DefaultConnection": "Host=localhost;Port=5432;Database=tesouro_direto;Username=app;Password=app123" },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "System": "Warning"
      }
    },
    "Enrich": ["FromLogContext"]
  },
  "ApiKey": {
    "Key": "CHANGE-ME-IN-PRODUCTION",
    "ExcludedPaths": ["/health", "/metrics"]
  },
  "CsvImport": {
    "Url": "https://www.tesourotransparente.gov.br/ckan/dataset/df56aa42-484a-4a59-8184-7676580c81e3/resource/796d2059-14e9-44e3-80c9-2d9e30b405c1/download/precotaxatesourodireto.csv",
    "CronSchedule": "0 0 6 * * ?"
  },
  "FeriadoImport": {
    "Url": "https://www.anbima.com.br/feriados/arqs/feriados_nacionais.xls"
  },
  "Feriados": {
    "CronSchedule": "0 0 6 1 12 ?"
  },
  "FocusBcb": {
    "BaseUrl": "https://olinda.bcb.gov.br/olinda/servico/Expectativas/versao/v1/odata/",
    "CacheTtl": "06:00:00",
    "MaxFallbackAge": "7.00:00:00"
  },
  "Resilience": {
    "FocusBcb": {
      "TotalTimeout": "00:00:25",
      "Retry": { "MaxAttempts": 2, "BaseDelay": "00:00:00.500" },
      "CircuitBreaker": {
        "FailureRatio": 0.5,
        "MinimumThroughput": 10,
        "SamplingDuration": "00:00:30",
        "BreakDuration": "00:00:15"
      },
      "AttemptTimeout": "00:00:06"
    },
    "CsvImport": {
      "Retry": { "MaxAttempts": 3, "BaseDelay": "00:00:02" },
      "AttemptTimeout": "00:00:45"
    },
    "FeriadoImport": {
      "Retry": { "MaxAttempts": 3, "BaseDelay": "00:00:02" },
      "AttemptTimeout": "00:00:45"
    }
  }
}
