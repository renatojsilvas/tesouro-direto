<div class="exemplo-codigo">
    @if (!string.IsNullOrWhiteSpace(Titulo))
    {
        <p class="exemplo-codigo-titulo">@Titulo</p>
    }
    <div class="exemplo-codigo-tabs" role="tablist">
        <button type="button" class="exemplo-codigo-tab @(abaAtiva == Aba.Curl ? "active" : "")" data-testid="exemplo-curl" role="tab" aria-selected="@(abaAtiva == Aba.Curl ? "true" : "false")" @onclick="() => abaAtiva = Aba.Curl">cURL</button>
        <button type="button" class="exemplo-codigo-tab @(abaAtiva == Aba.CSharp ? "active" : "")" data-testid="exemplo-csharp" role="tab" aria-selected="@(abaAtiva == Aba.CSharp ? "true" : "false")" @onclick="() => abaAtiva = Aba.CSharp">C#</button>
        <button type="button" class="exemplo-codigo-tab @(abaAtiva == Aba.JavaScript ? "active" : "")" data-testid="exemplo-js" role="tab" aria-selected="@(abaAtiva == Aba.JavaScript ? "true" : "false")" @onclick="() => abaAtiva = Aba.JavaScript">JavaScript</button>
    </div>
    <pre class="exemplo-codigo-bloco" data-testid="exemplo-codigo"><code>@TrechoAtivo</code></pre>
</div>

@code {
    private enum Aba
    {
        Curl,
        CSharp,
        JavaScript
    }

    private Aba abaAtiva = Aba.Curl;

    [Parameter]
    public string? Titulo { get; set; }

    [Parameter]
    public string CurlCodigo { get; set; } = string.Empty;

    [Parameter]
    public string CSharpCodigo { get; set; } = string.Empty;

    [Parameter]
    public string JsCodigo { get; set; } = string.Empty;

    private string TrechoAtivo => abaAtiva switch
    {
        Aba.CSharp => CSharpCodigo,
        Aba.JavaScript => JsCodigo,
        _ => CurlCodigo
    };
}
