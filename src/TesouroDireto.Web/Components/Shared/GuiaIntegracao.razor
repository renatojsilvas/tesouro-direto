<div data-testid="guia-integracao">
    <p>
        Três passos para a sua primeira chamada — pense neles como o verso da apólice, onde
        ficam as instruções de uso do selo.
    </p>

    <h3 class="h6">1. Pegue sua chave</h3>
    <p>
        Entre em <a href="/desenvolvedores">/desenvolvedores</a> e gere uma chave de API. Ela é
        mostrada uma única vez — guarde-a com cuidado.
    </p>

    <h3 class="h6">2. Faça a primeira requisição</h3>
    <p>Envie a chave no cabeçalho <code>X-Api-Key</code> e liste os títulos disponíveis:</p>
    <ExemploCodigo CurlCodigo="@primeiraRequisicaoCurl" CSharpCodigo="@primeiraRequisicaoCSharp" JsCodigo="@primeiraRequisicaoJs" />

    <h3 class="h6">3. Siga o caminho quente</h3>
    <p>
        O fluxo típico é: listar os títulos, escolher um pelo <code>codigo</code>, consultar o
        preço atual e, se precisar de histórico, paginar a série de preços.
    </p>
    <ExemploCodigo CurlCodigo="@caminhoQuenteCurl" CSharpCodigo="@caminhoQuenteCSharp" JsCodigo="@caminhoQuenteJs" />

    <p class="text-muted">
        Limites (<code>429</code> + <code>Retry-After</code>), cache condicional
        (<code>If-None-Match</code>), paginação (<code>X-Total-Count</code>,
        <code>_links</code>) e erros (<code>application/problem+json</code>) estão
        documentados em detalhe nas seções abaixo.
    </p>
</div>

@code {
    [Parameter]
    public string BaseUrl { get; set; } = "https://dadosdotesourodireto.com.br/api/v1";

    private static string Linhas(params string[] linhas) => string.Join("\n", linhas);

    private string primeiraRequisicaoCurl => Linhas(
        "curl -H \"X-Api-Key: SUA_CHAVE\" \\",
        $"  {BaseUrl}/titulos");

    private string primeiraRequisicaoCSharp => Linhas(
        $"var client = new HttpClient {{ BaseAddress = new Uri(\"{BaseUrl}/\") }};",
        "client.DefaultRequestHeaders.Add(\"X-Api-Key\", \"SUA_CHAVE\");",
        "",
        "var titulos = await client.GetFromJsonAsync<List<TituloResource>>(\"titulos\");");

    private string primeiraRequisicaoJs => Linhas(
        $"const base = \"{BaseUrl}\";",
        "const headers = { \"X-Api-Key\": \"SUA_CHAVE\" };",
        "",
        "const titulos = await (await fetch(`${base}/titulos`, { headers })).json();");

    private string caminhoQuenteCurl => Linhas(
        "curl -H \"X-Api-Key: SUA_CHAVE\" \\",
        $"  {BaseUrl}/titulos/{{codigo}}/preco-atual",
        "",
        "curl -H \"X-Api-Key: SUA_CHAVE\" \\",
        $"  \"{BaseUrl}/titulos/{{codigo}}/precos?page=1&pageSize=50\"");

    private string caminhoQuenteCSharp => Linhas(
        "var titulos = await client.GetFromJsonAsync<List<TituloResource>>(\"titulos\");",
        "var codigo = titulos![0].Codigo;",
        "",
        "var precoAtual = await client.GetFromJsonAsync<PrecoTaxaDto>($\"titulos/{codigo}/preco-atual\");",
        "",
        "var precos = await client.GetFromJsonAsync<List<PrecoTaxaDto>>(",
        "    $\"titulos/{codigo}/precos?page=1&pageSize=50\");");

    private string caminhoQuenteJs => Linhas(
        "const codigo = titulos[0].codigo;",
        "",
        "const precoAtual = await (await fetch(`${base}/titulos/${codigo}/preco-atual`, { headers })).json();",
        "",
        "const precos = await (await fetch(`${base}/titulos/${codigo}/precos?page=1&pageSize=50`, { headers })).json();");
}
