@page "/desenvolvedores"
@attribute [Authorize]
@rendermode InteractiveServer

<PageTitle>Desenvolvedores</PageTitle>

<div class="page-header fade-in">
    <h1>Desenvolvedores</h1>
    <p class="subtitle">Credenciais de acesso à API</p>
</div>

<div class="card mb-4" style="border-color: var(--ouro-selo);">
    <div class="card-body">
        <h5 class="card-title" style="color: var(--tinta);">Documentação da API</h5>
        <p class="card-text" style="color: var(--tinta-suave);">
            Consulte os endpoints, exemplos de requisição e códigos de erro na referência pública da API.
        </p>
        <a href="/docs" class="btn btn-outline-secondary" style="color: var(--ouro-texto); border-color: var(--ouro-selo);" data-testid="link-docs">Ver documentação</a>
    </div>
</div>

<ApiKeysPanel />
