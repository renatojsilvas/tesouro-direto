@page "/historico"
@rendermode InteractiveServer
@using TesouroDireto.Web.Services
@inject TesouroApiClient Api
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Historico</PageTitle>

<div class="page-header fade-in">
    <h1>Historico de Precos e Taxas</h1>
    <p class="subtitle">Evolucao de precos unitarios e taxas com graficos interativos</p>
</div>

<div class="row mb-3">
    <div class="col-md-4">
        <label for="titulo" class="form-label">Título</label>
        @if (loadingTitulos)
        {
            <p><em>Carregando títulos...</em></p>
        }
        else
        {
            <select id="titulo" class="form-select" @bind="selectedTituloCodigo" @bind:after="CarregarPrecosAsync">
                <option value="">Selecione um título</option>
                @if (titulos is not null)
                {
                    @foreach (var titulo in titulos)
                    {
                        <option value="@titulo.Codigo">@titulo.TipoTitulo - @titulo.DataVencimento</option>
                    }
                }
            </select>
        }
    </div>
    <div class="col-md-3">
        <label for="dataInicio" class="form-label">Data Início</label>
        <input id="dataInicio" type="date" class="form-control" @bind="dataInicio" @bind:after="CarregarPrecosAsync" />
    </div>
    <div class="col-md-3">
        <label for="dataFim" class="form-label">Data Fim</label>
        <input id="dataFim" type="date" class="form-control" @bind="dataFim" @bind:after="CarregarPrecosAsync" />
    </div>
</div>

@if (erro is not null)
{
    <div class="alert alert-danger">@erro</div>
}

@if (loading)
{
    <p><em>Carregando preços...</em></p>
}

@if (pageItems is { Count: > 0 })
{
    <div class="card mb-4">
        <div class="card-body">
            <h5 class="card-title">PU Compra / PU Venda</h5>
            <canvas id="priceChart"></canvas>
        </div>
    </div>

    <p class="text-muted" data-testid="pg-info">@totalCount registro(s)</p>

    <div class="table-responsive">
        <table class="table table-sm table-striped" data-testid="tabela-precos">
            <thead>
                <tr>
                    <th>Data</th>
                    <th class="text-end">Taxa Compra</th>
                    <th class="text-end">Taxa Venda</th>
                    <th class="text-end">PU Compra</th>
                    <th class="text-end">PU Venda</th>
                    <th class="text-end">PU Base</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var preco in pageItems)
                {
                    <tr>
                        <td>@FormatDate(preco.DataBase)</td>
                        <td class="text-end">@FormatDecimal(preco.TaxaCompra, "N2")%</td>
                        <td class="text-end">@FormatDecimal(preco.TaxaVenda, "N2")%</td>
                        <td class="text-end">@FormatCurrency(preco.PuCompra)</td>
                        <td class="text-end">@FormatCurrency(preco.PuVenda)</td>
                        <td class="text-end">@FormatCurrency(preco.PuBase)</td>
                    </tr>
                }
            </tbody>
        </table>

        <div class="d-flex gap-2 mt-2">
            <button class="btn btn-sm btn-outline-secondary" data-testid="pg-first" disabled="@(links?.First is null || currentPage <= 1)" @onclick="IrPrimeiraAsync">Primeira</button>
            <button class="btn btn-sm btn-outline-secondary" data-testid="pg-prev" disabled="@(links?.Prev is null)" @onclick="IrAnteriorAsync">Anterior</button>
            <button class="btn btn-sm btn-outline-secondary" data-testid="pg-next" disabled="@(links?.Next is null)" @onclick="IrProximaAsync">Próxima</button>
            <button class="btn btn-sm btn-outline-secondary" data-testid="pg-last" disabled="@(links?.Last is null || currentPage >= LastPage)" @onclick="IrUltimaAsync">Última</button>
        </div>
    </div>
}
else if (!loading && selectedTituloCodigo != "")
{
    <p class="text-muted" data-testid="vazio">Nenhum registro encontrado para o período.</p>
}

@code {
    private const int PageSize = 25;

    private List<TituloItem>? titulos;
    private List<PrecoItem>? pageItems;
    private int totalCount;
    private PageLinks? links;
    private int currentPage = 1;
    private bool loadingTitulos = true;
    private bool loading;
    private string? erro;
    private string selectedTituloCodigo = "";
    private DateTime? dataInicio;
    private DateTime? dataFim;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            titulos = await Api.GetAsync<List<TituloItem>>("v1/titulos");
        }
        catch (Exception ex)
        {
            erro = $"Falha ao carregar títulos: {ex.Message}";
        }
        finally
        {
            loadingTitulos = false;
        }
    }

    private async Task CarregarPrecosAsync()
    {
        if (string.IsNullOrEmpty(selectedTituloCodigo))
        {
            pageItems = null;
            links = null;
            totalCount = 0;
            return;
        }

        var tituloSelecionado = titulos?.FirstOrDefault(t => t.Codigo == selectedTituloCodigo);
        if (tituloSelecionado?.Links is null || !tituloSelecionado.Links.TryGetValue("precos", out var precosLink))
        {
            erro = "Título selecionado não possui link de preços.";
            pageItems = null;
            return;
        }

        var queryParams = new List<string> { "page=1", $"pageSize={PageSize}" };

        if (dataInicio.HasValue)
        {
            queryParams.Add($"dataInicio={DateOnly.FromDateTime(dataInicio.Value):yyyy-MM-dd}");
        }

        if (dataFim.HasValue)
        {
            queryParams.Add($"dataFim={DateOnly.FromDateTime(dataFim.Value):yyyy-MM-dd}");
        }

        currentPage = 1;
        await CarregarPaginaAsync(precosLink.Href + "?" + string.Join("&", queryParams));
    }

    private async Task CarregarPaginaAsync(string url)
    {
        loading = true;
        erro = null;

        try
        {
            var pagina = await Api.GetPagedAsync<PrecoItem>(url);
            pageItems = pagina.Items.ToList();
            totalCount = pagina.TotalCount;
            links = pagina.Links;
            chartPending = pageItems is { Count: > 0 };
        }
        catch (Exception ex)
        {
            erro = $"Falha ao carregar preços: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private int LastPage => totalCount > 0 ? (int)Math.Ceiling(totalCount / (double)PageSize) : 1;

    private Task IrPrimeiraAsync()
    {
        if (links?.First is null)
        {
            return Task.CompletedTask;
        }

        currentPage = 1;
        return CarregarPaginaAsync(links.First);
    }

    private Task IrAnteriorAsync()
    {
        if (links?.Prev is null)
        {
            return Task.CompletedTask;
        }

        currentPage--;
        return CarregarPaginaAsync(links.Prev);
    }

    private Task IrProximaAsync()
    {
        if (links?.Next is null)
        {
            return Task.CompletedTask;
        }

        currentPage++;
        return CarregarPaginaAsync(links.Next);
    }

    private Task IrUltimaAsync()
    {
        if (links?.Last is null)
        {
            return Task.CompletedTask;
        }

        currentPage = LastPage;
        return CarregarPaginaAsync(links.Last);
    }

    private bool chartPending;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (chartPending && pageItems is { Count: > 0 })
        {
            chartPending = false;

            var labels = pageItems.Select(p => FormatDate(p.DataBase)).ToArray();
            var datasets = new object[]
            {
                new { label = "PU Compra", data = pageItems.Select(p => p.PuCompra ?? 0).ToArray(), color = "#2E5F45" },
                new { label = "PU Venda", data = pageItems.Select(p => p.PuVenda ?? 0).ToArray(), color = "#A8823C" }
            };

            await JS.InvokeVoidAsync("chartInterop.createLineChart", "priceChart", labels, datasets);
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("chartInterop.destroyChart", "priceChart");
        }
        catch
        {
        }
    }

    private static string FormatDate(string date)
    {
        return DateOnly.TryParse(date, out var d) ? d.ToString("dd/MM/yyyy") : date;
    }

    private static readonly System.Globalization.CultureInfo Cultura = new("pt-BR");

    private static string FormatDecimal(decimal? value, string format)
    {
        return value?.ToString(format) ?? "-";
    }

    private static string FormatCurrency(decimal? value)
    {
        return value?.ToString("C2", Cultura) ?? "-";
    }
}
