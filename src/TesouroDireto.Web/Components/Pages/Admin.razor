@page "/admin"
@attribute [Authorize(Roles = "Admin")]
@rendermode InteractiveServer
@using TesouroDireto.Web.Services
@inject TesouroApiClient Api
@inject IActingUserContext ActingUser

<PageTitle>Admin</PageTitle>

<div class="page-header fade-in">
    <h1>Administração de Usuários</h1>
    <p class="subtitle">Aprove ou desative usuários pendentes</p>
</div>

@if (erro is not null)
{
    <div class="alert alert-danger" data-testid="erro">@erro</div>
}

@if (sucesso is not null)
{
    <div class="alert alert-success alert-dismissible" data-testid="sucesso">
        @sucesso
        <button type="button" class="btn-close" @onclick="() => sucesso = null"></button>
    </div>
}

@if (loading)
{
    <p><em>Carregando usuários pendentes...</em></p>
}
else if (pendentes is { Count: > 0 })
{
    <table class="table table-striped table-hover" data-testid="tabela-pendentes">
        <thead>
            <tr>
                <th>Email</th>
                <th>Nome</th>
                <th>Google Sub</th>
                <th>Criado Em</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var usuario in pendentes)
            {
                <tr>
                    <td>@usuario.Email</td>
                    <td>@usuario.Nome</td>
                    <td>@GoogleSubCurto(usuario.GoogleSub)</td>
                    <td>@usuario.CriadoEm.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</td>
                    <td>
                        <button class="btn btn-sm btn-success me-2" data-testid="btn-aprovar" @onclick="() => AprovarAsync(usuario.GoogleSub)">Aprovar</button>
                        <button class="btn btn-sm btn-outline-danger" data-testid="btn-desativar" @onclick="() => DesativarAsync(usuario.GoogleSub)">Desativar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <p class="text-muted">Nenhum usuário pendente.</p>
}

@code {
    private List<UsuarioPendenteItem>? pendentes;
    private bool loading = true;
    private string? erro;
    private string? sucesso;
    private string? sub;

    protected override async Task OnInitializedAsync()
    {
        sub = await ActingUser.GetGoogleSubAsync();
        await CarregarAsync();
    }

    private async Task CarregarAsync()
    {
        loading = true;
        erro = null;

        try
        {
            pendentes = await Api.GetAsync<List<UsuarioPendenteItem>>("v1/admin/usuarios?pendentes=true", sub);
        }
        catch (Exception ex)
        {
            erro = $"Falha ao carregar usuários pendentes: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task AprovarAsync(string googleSub)
    {
        erro = null;
        sucesso = null;

        var result = await Api.PostAsync<object>($"v1/admin/usuarios/{Uri.EscapeDataString(googleSub)}/aprovar", new { }, sub);

        if (result.IsSuccess)
        {
            sucesso = "Usuário aprovado.";
            await CarregarAsync();
        }
        else
        {
            erro = result.Error?.Detail ?? $"Erro: HTTP {result.StatusCode}";
        }
    }

    private async Task DesativarAsync(string googleSub)
    {
        erro = null;
        sucesso = null;

        var result = await Api.PostAsync<object>($"v1/admin/usuarios/{Uri.EscapeDataString(googleSub)}/desativar", new { }, sub);

        if (result.IsSuccess)
        {
            sucesso = "Usuário desativado.";
            await CarregarAsync();
        }
        else
        {
            erro = result.Error?.Detail ?? $"Erro: HTTP {result.StatusCode}";
        }
    }

    private static string GoogleSubCurto(string googleSub) =>
        googleSub.Length <= 12 ? googleSub : $"{googleSub[..8]}…{googleSub[^4..]}";
}
