# Copie para .env e preencha:  cp .env.example .env
# O .env NUNCA vai para o repositório (está no .gitignore). Este arquivo tem só
# NOMES de variáveis — nenhum valor real. Para uso local, qualquer valor não-vazio
# serve nas obrigatórias; os valores reais só importam em produção.

# --- Obrigatórias (o docker compose falha o boot se estiverem vazias) ---

# Chave de API compartilhada entre a API e o Web (header X-Api-Key).
API_KEY=

# E-mail do usuario que recebe papel Admin aprovado automaticamente no boot.
ADMIN_EMAIL=

# 77.0: URL de remote_write do Prometheus do Grafana Cloud (página "Details" da stack).
GC_PROM_URL=

# 77.0: Username/Instance ID numérico do Prometheus (página "Details" da stack).
GC_PROM_USER=

# 77.0: Access Policy Token com escopos metrics:write e logs:write (Grafana Cloud > Access Policies).
GC_TOKEN=

# 77.2: URL de push do Loki do Grafana Cloud (página "Details" da stack).
GC_LOKI_URL=

# 77.2: Username/Instance ID numérico do Loki (página "Details" da stack).
GC_LOKI_USER=

# 77.2: salt do hash de IP (LGPD) aplicado no nginx antes do envio ao Grafana Cloud.
# Gerar com: openssl rand -hex 32
GC_IP_SALT=

# --- Obrigatória para provisionar alerting (não para o docker compose; a 77.4 removeu o
# serviço `grafana`, que era quem exigia esta variável no boot do compose) ---

# Token do bot do Telegram, consumido pelo scripts/grafana-cloud/apply-cloud.sh
# para provisionar a entrega de alerta a partir do Grafana Cloud (placeholder
# serve localmente).
TELEGRAM_BOT_TOKEN=

# --- Opcionais (têm default no docker-compose.yml; descomente para sobrescrever) ---

# Senha do Postgres. Default: app123
# DB_PASSWORD=
